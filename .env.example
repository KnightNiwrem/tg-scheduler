# Bun loads this file automatically after copying it to .env.
# Compose supplies its own internal Valkey address to the worker.
VALKEY_URL=redis://127.0.0.1:6379/0
# Compose-only host port; keep VALKEY_URL in sync for host-run commands.
VALKEY_PORT=6379
QUEUE_NAME=tg-scheduler-bootstrap
WORKER_CONCURRENCY=1
